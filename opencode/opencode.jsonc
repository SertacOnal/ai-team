{
  "$schema": "https://opencode.ai/config.json",

  // Generic AI Team Configuration
  // Copy or reference this as base for your projects

  "model": "anthropic/claude-sonnet-4-5",

  // Enable formatter for consistent code style
  "formatter": true,

  // Enable snapshots for undo/redo
  "snapshots": true,

  // Common watcher ignores
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      ".git/**",
      "*.log",
      ".env",
      ".env.*"
    ]
  },

  // Load principles as instructions
  "instructions": [
    "AGENTS.md",
    "principles.md"
  ]
}
