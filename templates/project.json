{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "project-name",
  "description": "Brief project description",
  
  "runtime": {
    "node": "24",
    "python": "3.11"
  },
  
  "commands": {
    "setup": {
      "description": "Install dependencies and prepare environment",
      "cwd": ".",
      "command": "npm install"
    },
    "start": {
      "description": "Start development server",
      "cwd": ".",
      "command": "npm run dev"
    },
    "test": {
      "description": "Run test suite",
      "cwd": ".",
      "command": "npm test"
    },
    "build": {
      "description": "Production build",
      "cwd": ".",
      "command": "npm run build"
    },
    "lint": {
      "description": "Run linter",
      "cwd": ".",
      "command": "npm run lint"
    },
    "typecheck": {
      "description": "TypeScript type checking",
      "cwd": ".",
      "command": "npm run typecheck"
    }
  },
  
  "components": [
    {
      "name": "component-name",
      "path": "src/",
      "commands": {
        "test": "npm test",
        "build": "npm run build"
      }
    }
  ],
  
  "environment": {
    "example": ".env.example",
    "notes": "Copy .env.example to .env and configure. Never commit actual values."
  },
  
  "services": [
    {
      "name": "database",
      "type": "postgresql",
      "local": "docker compose up -d db"
    }
  ],
  
  "notes": {
    "coverage": "Minimum 20% statements, target 80%",
    "testing": "Use mocks at external boundaries, synthetic fixtures only",
    "deployment": "Requires explicit user authorization"
  }
}
